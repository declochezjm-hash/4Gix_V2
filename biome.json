{
	"$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": [
			"**",
			"!**/node_modules",
			"!**/dist",
			"!**/.vite",
			"!apps/backend/vendor",
			"!apps/backend/data/workspace"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"lineWidth": 88
	},
	"linter": {
		"enabled": true,
		"rules": {
			"a11y": {
				"noStaticElementInteractions": "error",
				"useSemanticElements": "error"
			},
			"suspicious": {
				"noArrayIndexKey": "error"
			},
			"correctness": {
				"noUnusedFunctionParameters": "error"
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double",
			"semicolons": "always"
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"overrides": [
		{
			"includes": ["**/N8nEdge.tsx"],
			"linter": {
				"rules": {
					"a11y": {
						"noStaticElementInteractions": "off",
						"useSemanticElements": "off"
					}
				}
			}
		},
		{
			"includes": ["**/index.css"],
			"linter": {
				"rules": {
					"style": {
						"noDescendingSpecificity": "off"
					}
				}
			}
		}
	]
}
